                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Student registration endpoint responds successfully\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Registration response is not empty\", function () {",
