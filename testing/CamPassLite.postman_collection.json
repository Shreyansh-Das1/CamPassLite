          "name": "CreateEvent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Event creation successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const eventData = pm.response.json();",
                  "    pm.test(\"Event title is correct\", function () {",
                  "        pm.expect(eventData.title).to.eql(\"TechFest 2026\");",
                  "    });",
                  "    pm.test(\"Event ID is present\", function () {",
                  "        pm.expect(eventData.Eventid).to.be.a(\"number\");",
                  "    });",
                  "    if (typeof eventData.Eventid === \"number\") {",
                  "        pm.environment.set(\"eventId\", String(eventData.Eventid));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
