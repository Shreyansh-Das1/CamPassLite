        {
          "name": "StudentProfile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Profile request successful\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const profile = pm.response.json();",
                  "  pm.test(\"Profile email matches student\", function () { pm.expect(profile.email).to.eql(pm.environment.get(\"studentEmail\")); });",
                  "  pm.test(\"Profile role is STUDENT\", function () { pm.expect(profile.role).to.eql(\"STUDENT\"); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
